# ===========================================
# CCTP Bridge 环境变量配置
# 复制此文件为 .env.local 使用
# ===========================================

# Reown (WalletConnect) Project ID
# 从 https://cloud.reown.com 获取
NEXT_PUBLIC_REOWN_PROJECT_ID=YOUR_PROJECT_ID_HERE

# Optional: if set, EVM reads prefer Alchemy for supported chains, with public/official fallbacks.
NEXT_PUBLIC_ALCHEMY_API_KEY=

# ===========================================
# RPC 节点配置
# ===========================================

# Solana Mainnet RPC
NEXT_PUBLIC_SOLANA_RPC_URL=https://solana-rpc.publicnode.com

# ===========================================
# EVM 链公共 RPC URLs (以下为默认值，可按需替换为私有节点)
# ===========================================

# Ethereum Mainnet
NEXT_PUBLIC_ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com

# Cronos
NEXT_PUBLIC_CRONOS_RPC_URL=https://evm.cronos.org

# Arbitrum One
NEXT_PUBLIC_ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# OP Mainnet
NEXT_PUBLIC_OPTIMISM_RPC_URL=https://mainnet.optimism.io

# Base
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org

# Polygon
NEXT_PUBLIC_POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com

# Avalanche C-Chain
NEXT_PUBLIC_AVALANCHE_RPC_URL=https://api.avax.network/ext/bc/C/rpc

# Linea Mainnet
NEXT_PUBLIC_LINEA_RPC_URL=https://rpc.linea.build

# Unichain
NEXT_PUBLIC_UNICHAIN_RPC_URL=https://mainnet.unichain.org

# Sonic
NEXT_PUBLIC_SONIC_RPC_URL=https://rpc.soniclabs.com

# World Chain
NEXT_PUBLIC_WORLDCHAIN_RPC_URL=https://worldchain-mainnet.g.alchemy.com/public

# Sei Network
NEXT_PUBLIC_SEI_RPC_URL=https://evm-rpc.sei-apis.com

# Ink
NEXT_PUBLIC_INK_RPC_URL=https://rpc-gel.inkonchain.com

# Monad
NEXT_PUBLIC_MONAD_RPC_URL=https://monad-mainnet.drpc.org

# Codex
NEXT_PUBLIC_CODEX_RPC_URL=https://rpc.codex.xyz

# XDC Network
NEXT_PUBLIC_XDC_RPC_URL=https://erpc.xdcrpc.com

# HyperEVM
NEXT_PUBLIC_HYPEREVM_RPC_URL=https://rpc.hyperliquid.xyz/evm

# Plume
NEXT_PUBLIC_PLUME_RPC_URL=https://rpc.plume.org

# EDGE
NEXT_PUBLIC_EDGE_RPC_URL=https://edge-mainnet.g.alchemy.com/public

# Injective
NEXT_PUBLIC_INJECTIVE_RPC_URL=https://sentry.evm-rpc.injective.network

# Morph
NEXT_PUBLIC_MORPH_RPC_URL=https://rpc.morphl2.io

# Pharos
NEXT_PUBLIC_PHAROS_RPC_URL=https://rpc.pharos.xyz
